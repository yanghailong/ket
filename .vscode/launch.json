"tasks": [
    {
        "type": "cppbuild",
        "label": "C/C++: clang++ 生成活动文件",
        "command": "/usr/bin/clang++", // 确保这里是 clang++
        "args": [
            "-std=c++17", // 推荐使用更现代的标准
            "-fcolor-diagnostics",
            "-fansi-escape-codes",
            "-g",
            "${file}",
            "-o",
            "${fileDirname}/${fileBasenameNoExtension}"
        ],
        // ... 其他配置
    }
]